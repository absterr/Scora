{
  "expo": {
    "name": "Scora",
    "slug": "Scora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-dark.png",
    "scheme": "scora",
    "userInterfaceStyle": "automatic",
    "predictiveBackGestureEnabled": false
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/images/logo-light.png"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#FAFAFA",
        "image": "./assets/images/logo-light.png",
        "imageWidth": 76,
        "resizeMode": "contain",
        "dark": {
          "image": "./assets/images/logo-dark.png",
          "backgroundColor": "#090909"
        }
      }
    ],
    "expo-font"
  ],
  "experiments": {
    "typedRoutes": true,
    "reactCompiler": true
  }
}
